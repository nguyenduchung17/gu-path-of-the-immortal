{
  "name": "GameSave",
  "title": "Game Save",
  "description": "A private, account-owned save slot for Path of the Immortal.",
  "type": "object",
  "properties": {
    "slot_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "character_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "save_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ALIVE",
        "DECEASED"
      ]
    },
    "client_updated_at": {
      "type": "number"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "slot_id",
    "character_id",
    "save_version",
    "status",
    "client_updated_at",
    "payload"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}